{
  "name": "noctra",
  "url": "https://getnoctra.dev",
  "description": "Autonomous ticket-to-PR agent. Pushes branches, opens pull requests and responds to review feedback on the repositories you choose.",
  "public": true,
  "hook_attributes": {
    "url": "https://auth.getnoctra.dev/webhook",
    "active": true
  },
  "redirect_url": "https://auth.getnoctra.dev/manifest-callback",
  "callback_urls": [
    "https://auth.getnoctra.dev/installed"
  ],
  "request_oauth_on_install": true,
  "setup_on_update": false,
  "default_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "issues": "write",
    "checks": "read",
    "actions": "read",
    "metadata": "read"
  },
  "default_events": []
}
